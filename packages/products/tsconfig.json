{
  "extends": "@zotijstestingms/config-typescript/tsconfig.base.json",
  "compilerOptions": {
    /* Aliases */
    "baseUrl": "./src/",
    "paths": {
      "config": ["config"],
      "cache/*": ["cache/*"],
      "database/*": ["database/*"],
      "events/*": ["events/*"],
      "repositories/*": ["repositories/*"],
      "routes/*": ["routes/*"],
      "services/*": ["services/*"]
    },
    /* Configuration */
    "target": "ESNext"
  },
  "include": ["src", "vite.config.ts"],
  "exclude": ["node_modules"]
}
