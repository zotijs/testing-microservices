{
  "name": "products",
  "version": "1.0.2",
  "description": "The products service",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch --env-file=.env ./src/index.ts",
    "build": "vite build",
    "start": "node dist/index.cjs",
    "lint": "eslint .",
    "typechecks": "tsc --noEmit",
    "test": "echo \"Error: no test specified\"",
    "generate:migrations": "drizzle-kit generate --dialect=postgresql --schema=./src/database/schema.ts --out=./src/database/migrations"
  },
  "keywords": [
    "vite",
    "vitest",
    "fastify"
  ],
  "author": "zotijs",
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@types/eslint__js": "^8.42.3",
    "@types/node": "^22.8.1",
    "@types/pg": "^8.11.10",
    "@zotijstestingms/config-eslint": "^1.0.2",
    "@zotijstestingms/config-typescript": "^1.0.2",
    "drizzle-kit": "^0.26.2",
    "eslint": "^9.13.0",
    "pino-pretty": "^11.3.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.11.0",
    "vite": "^5.4.10",
    "vite-tsconfig-paths": "^5.0.1",
    "vitest": "^2.1.4"
  },
  "dependencies": {
    "@zotijstestingms/common": "^1.0.2",
    "drizzle-orm": "^0.35.3",
    "fastify": "^5.0.0",
    "pg": "^8.13.1"
  }
}
